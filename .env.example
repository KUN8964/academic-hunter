# Academic Hunter — Environment Variables
# Copy this file to .env and fill in the values
# cp .env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://hunter:hunter@localhost:5432/academic_hunter

# JWT — generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=

# DeepSeek AI (or any OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Semantic Scholar (ai4scholar.net proxy — uses Bearer auth, 1 credit/request)
S2_API_KEY=
S2_BASE_URL=https://ai4scholar.net/graph/v1
# Credit budget: minimum credits to run daily pipeline
S2_CREDIT_BUDGET=50

# NCBI / PubMed (optional, increases rate limits from 3/sec to 10/sec)
NCBI_API_KEY=
NCBI_EMAIL=

# CORS — comma-separated origins for production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
