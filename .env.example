# Academic Hunter — Environment Variables
# Copy this file to .env and fill in the values
# cp .env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://hunter:hunter@localhost:5432/academic_hunter

# JWT — generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=

# DeepSeek AI
DEEPSEEK_API_KEY=

# Semantic Scholar (optional, increases rate limits)
S2_API_KEY=

# CORS — comma-separated origins for production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
